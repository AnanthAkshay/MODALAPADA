# Gaade Kosha - Environment Configuration Example
# Modalapada 2.0 (Kannada Multimodal AI Hackathon, Problem 2)

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration
DATABASE_PATH=data/gaade_kosha.db

# Audio Storage Configuration
AUDIO_DIR=audio/wav

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://modalapada.vercel.app

# Hosted ASR Provider Configuration (Fallback Voice Input for Brave/Firefox/Safari)
# Supported providers: "groq-whisper" (recommended/default), "sarvam", "google"
ASR_PROVIDER=groq-whisper

# API Key for chosen ASR provider (Groq, Sarvam, or Google)
# For Groq: https://console.groq.com/keys (whisper-large-v3, sub-second latency)
# For Sarvam: https://www.sarvam.ai/ (saaras:v1 Kannada ASR)
ASR_API_KEY=your_asr_api_key_here
# Optional provider-specific keys:
# GROQ_API_KEY=gsk_...
# SARVAM_API_KEY=...
# GOOGLE_API_KEY=AIza...

# ASR Limits & Timeouts
ASR_MAX_FILE_SIZE_BYTES=5242880
ASR_TIMEOUT_SECONDS=20.0
ASR_RATE_LIMIT_PER_MINUTE=20
ENABLE_BACKEND_ASR=true

